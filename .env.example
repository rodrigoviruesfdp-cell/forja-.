# Copia este archivo como .env.local (desarrollo) o pon estas variables en Vercel.
# Los valores están en Supabase: Project Settings -> API Keys / Data API.

# URL del proyecto, p. ej. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave "publishable" (empieza por sb_publishable_...). Es pública por diseño:
# los datos los protege Row Level Security. NUNCA pongas aquí la clave "secret".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
